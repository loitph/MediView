@inject MediViewApi Api

<div class="report">
    <div class="report__scroll">
        @if (Editable)
        {
            <div class="report__heading">
                <span class="report__eyebrow">Report</span>
                <span class="report__saved">@saveState</span>
            </div>

            @if (draft is null)
            {
                <p class="report__text">@(loadFailure ?? "Opening the draft…")</p>
            }
            else
            {
                <label class="report__field">
                    <span class="report__label">Findings</span>
                    <textarea class="report__input report__input--area" rows="5" @bind="findings" @bind:after="SaveTextAsync" disabled="@busy"></textarea>
                </label>

                <label class="report__field">
                    <span class="report__label">Impression</span>
                    <textarea class="report__input report__input--area" rows="3" @bind="impression" @bind:after="SaveTextAsync" disabled="@busy"></textarea>
                </label>

                <div class="report__field">
                    <span class="report__label">Medications</span>
                    @if (draft.Medications.Count > 0)
                    {
                        <ul class="meds">
                            @foreach (var medication in draft.Medications)
                            {
                                <li @key="medication.Id" class="meds__row">
                                    <span class="meds__name">@medication.DrugName</span>
                                    <span class="meds__detail">@medication.Dosage · @medication.Frequency · @medication.Duration</span>
                                    <button type="button" class="meds__remove" aria-label="@($"Remove {medication.DrugName}")" disabled="@busy" @onclick="() => RemoveMedicationAsync(medication.Id)">×</button>
                                </li>
                            }
                        </ul>
                    }

                    <div class="meds__form">
                        <input class="report__input meds__drug" placeholder="Drug" aria-label="Drug" @bind="newMedication.DrugName" disabled="@busy" />
                        <input class="report__input" placeholder="Dosage" aria-label="Dosage" @bind="newMedication.Dosage" disabled="@busy" />
                        <input class="report__input" placeholder="Frequency" aria-label="Frequency" @bind="newMedication.Frequency" disabled="@busy" />
                        <input class="report__input" placeholder="Duration" aria-label="Duration" @bind="newMedication.Duration" disabled="@busy" />
                        <button type="button" class="report__secondary meds__add" disabled="@(busy || !newMedication.IsComplete())" @onclick="AddMedicationAsync">Add medication</button>
                    </div>
                </div>
            }
        }

        @{ var finalizedReports = FinalizedReports(); }
        @if (finalizedReports.Count > 0)
        {
            <div class="report__heading report__heading--history">
                <span class="report__eyebrow">@(Editable ? "Earlier reports" : "Finalized reports")</span>
            </div>
            @foreach (var report in finalizedReports)
            {
                <article @key="report.Id" class="earlier">
                    <span class="earlier__meta">@(report.FinalizedAt is null ? null : ClinicTime.DayAndTime(report.FinalizedAt.Value)) · @report.DoctorName · @DecisionLabel(report.Decision)</span>
                    <p class="earlier__impression">@report.Impression</p>
                    <p class="earlier__findings">@report.Findings</p>
                    @foreach (var medication in report.Medications)
                    {
                        <p class="earlier__medication">@medication.DrugName · @medication.Dosage · @medication.Frequency · @medication.Duration</p>
                    }
                </article>
            }
        }
        else if (!Editable && reports is not null)
        {
            <p class="report__text">No finalized report yet.</p>
        }
    </div>

    @if (Editable && draft is not null)
    {
        <div class="report__actions">
            @if (problem is not null)
            {
                <p class="report__problem" role="alert">@problem</p>
            }

            <div class="decision" role="radiogroup" aria-label="Decision">
                @foreach (var option in Decisions)
                {
                    var isChosen = option == decision;
                    <button type="button" role="radio" aria-checked="@(isChosen ? "true" : "false")" class="decision__option @(isChosen ? "decision__option--chosen" : null)" disabled="@busy" @onclick="() => decision = option">
                        @DecisionLabel(option)
                    </button>
                }
            </div>

            <button type="button" class="report__primary" disabled="@(busy || !CanFinalize())" @onclick="FinalizeAsync">Finalize</button>
        </div>
    }
</div>

@code {
    private static readonly List<ReportDecision> Decisions = [ReportDecision.Complete, ReportDecision.ReDiagnosis];

    private List<ReportView>? reports;
    private ReportView? draft;
    private string? findings;
    private string? impression;
    private string? savedFindings;
    private string? savedImpression;
    private Task lastSave = Task.CompletedTask;
    private NewMedication newMedication = new();
    private ReportDecision decision = ReportDecision.Complete;
    private string? saveState;
    private string? problem;
    private string? loadFailure;
    private bool busy;

    [Parameter, EditorRequired]
    public Guid StudyId { get; set; }

    [Parameter]
    public bool Editable { get; set; }

    [Parameter]
    public EventCallback OnFinalized { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Editable)
        {
            loadFailure = await Api.StartReportAsync(StudyId);
        }

        await LoadReportsAsync();

        findings = draft?.Findings;
        impression = draft?.Impression;
        savedFindings = findings;
        savedImpression = impression;
    }

    private async Task LoadReportsAsync()
    {
        reports = await Api.ListReportsAsync(StudyId);
        draft = Editable ? reports.FirstOrDefault(report => report.Status == ReportStatus.Draft) : null;
    }

    private List<ReportView> FinalizedReports()
    {
        if (reports is null)
        {
            return [];
        }

        return reports.Where(report => report.Status == ReportStatus.Finalized).ToList();
    }

    private bool CanFinalize() => !string.IsNullOrWhiteSpace(findings) && !string.IsNullOrWhiteSpace(impression);

    private static string DecisionLabel(ReportDecision? decision)
    {
        return decision switch
        {
            ReportDecision.Complete => "Complete",
            ReportDecision.ReDiagnosis => "Re-diagnosis",
            _ => "",
        };
    }

    private Task SaveTextAsync()
    {
        lastSave = SaveTextAfterPreviousSaveAsync(lastSave);
        return lastSave;
    }

    private async Task SaveTextAfterPreviousSaveAsync(Task previousSave)
    {
        await previousSave;

        var nothingChanged = findings == savedFindings && impression == savedImpression;
        if (draft is null || nothingChanged)
        {
            return;
        }

        var sentFindings = findings;
        var sentImpression = impression;
        saveState = "Saving…";

        problem = await Api.UpdateReportAsync(draft.Id, sentFindings, sentImpression);
        if (problem is not null)
        {
            saveState = "Not saved";
            return;
        }

        savedFindings = sentFindings;
        savedImpression = sentImpression;
        saveState = $"Saved {ClinicTime.Time(DateTimeOffset.UtcNow)}";
    }

    private async Task AddMedicationAsync()
    {
        if (draft is null)
        {
            return;
        }

        busy = true;

        var medication = new MedicationRequest(newMedication.DrugName, newMedication.Dosage, newMedication.Frequency, newMedication.Duration);
        problem = await Api.AddMedicationAsync(draft.Id, medication);
        if (problem is null)
        {
            newMedication = new NewMedication();
        }

        await LoadReportsAsync();
        busy = false;
    }

    private async Task RemoveMedicationAsync(Guid medicationId)
    {
        if (draft is null)
        {
            return;
        }

        busy = true;
        problem = await Api.RemoveMedicationAsync(draft.Id, medicationId);
        await LoadReportsAsync();
        busy = false;
    }

    private async Task FinalizeAsync()
    {
        if (draft is null)
        {
            return;
        }

        busy = true;
        problem = null;

        await SaveTextAsync();
        if (problem is null)
        {
            problem = await Api.FinalizeReportAsync(draft.Id, decision);
            if (problem is null)
            {
                await OnFinalized.InvokeAsync();
            }
        }

        busy = false;
    }

    private class NewMedication
    {
        public string DrugName { get; set; } = "";
        public string Dosage { get; set; } = "";
        public string Frequency { get; set; } = "";
        public string Duration { get; set; } = "";

        public bool IsComplete() =>
            !string.IsNullOrWhiteSpace(DrugName)
            && !string.IsNullOrWhiteSpace(Dosage)
            && !string.IsNullOrWhiteSpace(Frequency)
            && !string.IsNullOrWhiteSpace(Duration);
    }
}
