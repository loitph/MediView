@page "/admin/doctors"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject MediViewApi Api

<AuthorizeView Roles="@Roles.Admin" Context="admin">
    <Authorized>
        <TopBar Title="Doctors" Meta="@(doctors is null ? null : $"{doctors.Count} on staff")" />

        <div class="mv-page">
            <section class="mv-page__main" aria-label="Doctors on staff">
                <div class="mv-card">
                    <table class="mv-table">
                        <thead>
                            <tr>
                                <th scope="col">Doctor</th>
                                <th scope="col">Specialty</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doctor in doctors ?? [])
                            {
                                <tr @key="doctor.Id">
                                    <td>
                                        <div class="mv-table__primary">
                                            <span class="mv-avatar mv-avatar--soft" aria-hidden="true">@Initials.Of(doctor.FullName)</span>
                                            <span class="mv-table__name">@doctor.FullName</span>
                                        </div>
                                    </td>
                                    <td>@doctor.Specialty</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (doctors is null)
                    {
                        <p class="mv-table__empty">Loading doctors…</p>
                    }
                    else if (doctors.Count == 0)
                    {
                        <p class="mv-table__empty">No doctors yet — create the first one with the form.</p>
                    }

                    <p class="mv-card__footer mv-small-print">
                        A doctor is bookable as soon as the account exists: availability is the weekly hours expanded
                        into slots for a date range, minus the slots already booked.
                    </p>
                </div>
            </section>

            <section class="mv-page__side mv-page__side--form">
                <div class="mv-card">
                    <div class="mv-card__header">
                        <h2 class="mv-card__title">New doctor account</h2>
                    </div>

                    <EditForm Model="form" OnValidSubmit="CreateAsync" FormName="create-doctor" class="mv-card__body">
                        <DataAnnotationsValidator />

                        <div class="mv-form-grid">
                            <div class="mv-field mv-field--wide">
                                <label for="email" class="mv-field__label">Email</label>
                                <InputText id="email" type="email" class="mv-input" autocomplete="off" @bind-Value="form.Email" />
                                <ValidationMessage For="() => form.Email" />
                            </div>
                            <div class="mv-field">
                                <label for="full-name" class="mv-field__label">Full name</label>
                                <InputText id="full-name" class="mv-input" @bind-Value="form.FullName" />
                                <ValidationMessage For="() => form.FullName" />
                            </div>
                            <div class="mv-field">
                                <label for="specialty" class="mv-field__label">Specialty</label>
                                <InputText id="specialty" class="mv-input" @bind-Value="form.Specialty" />
                                <ValidationMessage For="() => form.Specialty" />
                            </div>
                            <div class="mv-field">
                                <label for="license" class="mv-field__label">Licence number</label>
                                <InputText id="license" class="mv-input mv-mono" @bind-Value="form.LicenseNumber" />
                                <ValidationMessage For="() => form.LicenseNumber" />
                            </div>
                            <div class="mv-field">
                                <label for="slot-minutes" class="mv-field__label">Slot length (min)</label>
                                <InputNumber id="slot-minutes" class="mv-input mv-mono" @bind-Value="form.SlotMinutes" />
                                <ValidationMessage For="() => form.SlotMinutes" />
                            </div>
                            <div class="mv-field mv-field--wide">
                                <label for="password" class="mv-field__label">Initial password</label>
                                <InputText id="password" type="password" class="mv-input" autocomplete="new-password" @bind-Value="form.Password" />
                                <ValidationMessage For="() => form.Password" />
                            </div>
                        </div>

                        <div class="schedule">
                            <div class="schedule__header">
                                <span id="schedule-label" class="mv-eyebrow">Weekly schedule</span>
                                <span class="schedule__hint">untick a day to keep it off</span>
                            </div>
                            <table class="schedule__table" aria-labelledby="schedule-label">
                                <tbody>
                                    @foreach (var day in form.Week)
                                    {
                                        <tr @key="day.DayOfWeek" class="@(day.Works ? null : "schedule__row--off")">
                                            <th scope="row">
                                                <label class="schedule__day">
                                                    <InputCheckbox @bind-Value="day.Works" />
                                                    @(day.DayOfWeek.ToString()[..3])
                                                </label>
                                            </th>
                                            <td>
                                                <InputSelect class="schedule__time" @bind-Value="day.Start" disabled="@(!day.Works)" aria-label="@($"{day.DayOfWeek} start")">
                                                    @foreach (var time in Times)
                                                    {
                                                        <option value="@time">@time</option>
                                                    }
                                                </InputSelect>
                                            </td>
                                            <td>
                                                <InputSelect class="schedule__time" @bind-Value="day.End" disabled="@(!day.Works)" aria-label="@($"{day.DayOfWeek} end")">
                                                    @foreach (var time in Times)
                                                    {
                                                        <option value="@time">@time</option>
                                                    }
                                                </InputSelect>
                                            </td>
                                            <td class="@SlotsCssClass(day)">@(day.Works ? $"{day.SlotCount(form.SlotMinutes)} slots" : "off")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (failure is not null)
                        {
                            <p class="mv-callout mv-callout--danger" role="alert">@failure</p>
                        }

                        @if (created is not null)
                        {
                            <p class="mv-callout mv-callout--info" role="status">@created can now sign in with the password you set.</p>
                        }

                        <p class="mv-small-print">
                            Saving writes the user, the doctor and the weekly hours in one transaction. You attest the
                            licence; there is no verification step.
                        </p>

                        <button type="submit" class="mv-button mv-button--create mv-button--block" disabled="@saving">Create doctor</button>
                    </EditForm>
                </div>
            </section>
        </div>
    </Authorized>
    <NotAuthorized>
        <TopBar Title="Doctors" />
        <div class="mv-page">
            <p class="mv-callout mv-callout--warning"><span><a href="login">Sign in</a> as an administrator to manage doctors.</span></p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly List<string> Times = EveryQuarterHour();

    private DoctorForm form = new();
    private List<DoctorSummary>? doctors;
    private string? failure;
    private string? created;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        doctors = await Api.ListDoctorsAsync();
    }

    private static List<string> EveryQuarterHour()
    {
        var times = new List<string>();
        for (var minutes = 0; minutes < 24 * 60; minutes += 15)
        {
            times.Add($"{minutes / 60:00}:{minutes % 60:00}");
        }

        return times;
    }

    private string SlotsCssClass(WorkingDay day)
    {
        if (!day.Works)
        {
            return "schedule__slots";
        }

        if (day.SlotCount(form.SlotMinutes) == 0)
        {
            return "schedule__slots schedule__slots--invalid";
        }

        return "schedule__slots schedule__slots--open";
    }

    private async Task CreateAsync()
    {
        created = null;

        var workingDays = form.Week.Where(day => day.Works).ToList();
        if (workingDays.Count == 0)
        {
            failure = "Pick at least one working day.";
            return;
        }

        var dayWithoutSlots = workingDays.FirstOrDefault(day => day.SlotCount(form.SlotMinutes) == 0);
        if (dayWithoutSlots is not null)
        {
            failure = $"{dayWithoutSlots.DayOfWeek} has no room for a {form.SlotMinutes}-minute slot. Check its hours.";
            return;
        }

        saving = true;

        var shifts = workingDays
            .Select(day => new ShiftRequest(day.DayOfWeek, day.StartTime, day.EndTime, form.SlotMinutes))
            .ToList();
        var request = new CreateDoctorRequest(form.FullName, form.Email, form.Password, form.LicenseNumber, form.Specialty, shifts);

        failure = await Api.CreateDoctorAsync(request);
        if (failure is null)
        {
            created = form.FullName;
            form = new DoctorForm();
            doctors = await Api.ListDoctorsAsync();
        }

        saving = false;
    }

    private class DoctorForm
    {
        [Required(ErrorMessage = "Enter the doctor's full name."), MaxLength(200)]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Enter the doctor's email."), EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Set an initial password."), MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Enter the licence number."), MaxLength(64)]
        public string LicenseNumber { get; set; } = "";

        [Required(ErrorMessage = "Enter the specialty."), MaxLength(100)]
        public string Specialty { get; set; } = "";

        [Range(5, 240, ErrorMessage = "Use 5 to 240 minutes.")]
        public int SlotMinutes { get; set; } = 30;

        public List<WorkingDay> Week { get; } =
        [
            new() { DayOfWeek = DayOfWeek.Monday, Works = true },
            new() { DayOfWeek = DayOfWeek.Tuesday, Works = true },
            new() { DayOfWeek = DayOfWeek.Wednesday, Works = true },
            new() { DayOfWeek = DayOfWeek.Thursday, Works = true },
            new() { DayOfWeek = DayOfWeek.Friday, Works = true },
            new() { DayOfWeek = DayOfWeek.Saturday },
            new() { DayOfWeek = DayOfWeek.Sunday },
        ];
    }

    private class WorkingDay
    {
        public DayOfWeek DayOfWeek { get; set; }
        public bool Works { get; set; }
        public string Start { get; set; } = "08:00";
        public string End { get; set; } = "16:00";

        public TimeOnly StartTime => TimeOnly.Parse(Start, CultureInfo.InvariantCulture);
        public TimeOnly EndTime => TimeOnly.Parse(End, CultureInfo.InvariantCulture);

        public int SlotCount(int slotMinutes)
        {
            if (slotMinutes <= 0 || StartTime >= EndTime)
            {
                return 0;
            }

            return (int)(EndTime - StartTime).TotalMinutes / slotMinutes;
        }
    }
}
