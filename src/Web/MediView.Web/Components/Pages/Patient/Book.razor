@page "/book"
@inject MediViewApi Api

<AuthorizeView Roles="@Roles.Patient" Context="patient">
    <Authorized>
        <TopBar Title="Book a checkup" Meta="@ShownDaysLabel()" />

        <div class="mv-page">
            <section class="mv-page__main" aria-label="Doctor and time">
                <div class="mv-card">
                    <div class="mv-card__header">
                        <h2 class="mv-card__title">Choose a doctor</h2>
                        <span class="mv-card__meta">@doctors?.Count</span>
                    </div>

                    @if (doctors is null)
                    {
                        <p class="mv-table__empty">Loading doctors…</p>
                    }
                    else if (doctors.Count == 0)
                    {
                        <p class="mv-table__empty">No doctors yet — an administrator creates one before you can book.</p>
                    }
                    else
                    {
                        <ul class="doctors">
                            @foreach (var doctor in doctors)
                            {
                                var isSelected = doctor == selectedDoctor;
                                <li @key="doctor.Id">
                                    <button type="button" class="doctor @(isSelected ? "doctor--selected" : null)" aria-pressed="@(isSelected ? "true" : "false")" @onclick="() => SelectDoctorAsync(doctor)">
                                        <span class="mv-avatar mv-avatar--soft" aria-hidden="true">@Initials.Of(doctor.FullName)</span>
                                        <span class="doctor__text">
                                            <span class="doctor__name">@doctor.FullName</span>
                                            <span class="doctor__specialty">@doctor.Specialty</span>
                                        </span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>

                @if (selectedDoctor is not null)
                {
                    <div class="mv-card">
                        <div class="mv-card__header">
                            <h2 class="mv-card__title">Choose a time</h2>
                            <div class="window-nav">
                                <button type="button" class="mv-button mv-button--secondary mv-button--compact" disabled="@(firstDay <= ClinicTime.Today || freeSlots is null)" @onclick="ShowEarlierAsync">Earlier</button>
                                <button type="button" class="mv-button mv-button--secondary mv-button--compact" disabled="@(freeSlots is null)" @onclick="ShowLaterAsync">Later</button>
                            </div>
                        </div>

                        <div class="mv-card__body">
                            <div class="days" role="group" aria-label="Day">
                                @foreach (var day in ShownDays())
                                {
                                    var freeCount = FreeSlotsOn(day).Count;
                                    var isSelected = day == selectedDay;
                                    <button type="button" class="day @(isSelected ? "day--selected" : null)" aria-pressed="@(isSelected ? "true" : "false")" disabled="@(freeCount == 0)" @onclick="() => SelectDay(day)">
                                        <span class="day__name">@ClinicTime.Weekday(day)</span>
                                        <span class="day__date">@day.Day</span>
                                        <span class="day__free">@(freeCount == 0 ? "no slots" : $"{freeCount} free")</span>
                                    </button>
                                }
                            </div>

                            @if (freeSlots is null)
                            {
                                <p class="mv-small-print">Loading free slots…</p>
                            }
                            else if (FreeSlotsOn(selectedDay).Count == 0)
                            {
                                <p class="mv-small-print">No free slots on these days — try later dates.</p>
                            }
                            else
                            {
                                <div class="slots" role="group" aria-label="Free slots">
                                    @foreach (var slot in FreeSlotsOn(selectedDay))
                                    {
                                        var isSelected = slot == selectedSlot;
                                        <button type="button" @key="slot.Start" class="slot @(isSelected ? "slot--selected" : null)" aria-pressed="@(isSelected ? "true" : "false")" @onclick="() => SelectSlot(slot)">
                                            @ClinicTime.Time(slot.Start)
                                        </button>
                                    }
                                </div>

                                <div class="legend" aria-hidden="true">
                                    <span class="legend__item"><span class="legend__swatch"></span>Free</span>
                                    <span class="legend__item"><span class="legend__swatch legend__swatch--selected"></span>Selected</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>

            <section class="mv-page__side mv-page__side--summary" aria-label="Booking summary">
                <div class="mv-card">
                    <div class="mv-card__header">
                        <h2 class="mv-card__title">Your booking</h2>
                    </div>

                    <div class="mv-card__body">
                        <dl class="mv-facts">
                            <div class="mv-facts__row">
                                <dt>Patient</dt>
                                <dd>@patient.User.GetName()</dd>
                            </div>
                        </dl>

                        <dl class="mv-facts">
                            <div class="mv-facts__row">
                                <dt>Doctor</dt>
                                <dd>@(selectedDoctor?.FullName ?? "—")</dd>
                            </div>
                            <div class="mv-facts__row">
                                <dt>Specialty</dt>
                                <dd>@(selectedDoctor?.Specialty ?? "—")</dd>
                            </div>
                            <div class="mv-facts__row">
                                <dt>Day</dt>
                                <dd>@(selectedSlot is null ? "—" : ClinicTime.Day(ClinicTime.DateOf(selectedSlot.Start)))</dd>
                            </div>
                            <div class="mv-facts__row">
                                <dt>Time</dt>
                                <dd class="mv-mono">@(selectedSlot is null ? "—" : $"{ClinicTime.Time(selectedSlot.Start)}–{ClinicTime.Time(selectedSlot.End)}")</dd>
                            </div>
                        </dl>

                        @if (failure is not null)
                        {
                            <p class="mv-callout mv-callout--danger" role="alert">@failure</p>
                        }

                        @if (confirmation is not null)
                        {
                            <p class="mv-callout mv-callout--info" role="status">
                                <span>@confirmation <a href="my-studies">See it in My studies</a>.</span>
                            </p>
                        }

                        <button type="button" class="mv-button mv-button--primary mv-button--block" disabled="@(selectedSlot is null || booking)" @onclick="ConfirmAsync">Confirm booking</button>
                    </div>
                </div>

                <p class="mv-callout mv-callout--info">
                    Booking copies your name and MRN onto the study. It shows as To do under My studies until your
                    doctor opens it.
                </p>
            </section>
        </div>
    </Authorized>
    <NotAuthorized>
        <TopBar Title="Book a checkup" />
        <div class="mv-page">
            <p class="mv-callout mv-callout--warning"><span><a href="login">Sign in</a> as a patient to book a checkup.</span></p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const int DaysShown = 5;

    private List<DoctorSummary>? doctors;
    private DoctorSummary? selectedDoctor;
    private DateOnly firstDay = ClinicTime.Today;
    private DateOnly selectedDay;
    private List<AvailableSlot>? freeSlots;
    private AvailableSlot? selectedSlot;
    private string? failure;
    private string? confirmation;
    private bool booking;

    protected override async Task OnInitializedAsync()
    {
        doctors = await Api.ListDoctorsAsync();
    }

    private List<DateOnly> ShownDays()
    {
        var days = new List<DateOnly>();
        for (var i = 0; i < DaysShown; i++)
        {
            days.Add(firstDay.AddDays(i));
        }

        return days;
    }

    private string? ShownDaysLabel()
    {
        if (selectedDoctor is null)
        {
            return null;
        }

        var lastDay = firstDay.AddDays(DaysShown - 1);
        return $"{ClinicTime.Day(firstDay)}–{ClinicTime.Day(lastDay)}";
    }

    private List<AvailableSlot> FreeSlotsOn(DateOnly day)
    {
        if (freeSlots is null)
        {
            return [];
        }

        return freeSlots.Where(slot => ClinicTime.DateOf(slot.Start) == day).ToList();
    }

    private async Task SelectDoctorAsync(DoctorSummary doctor)
    {
        selectedDoctor = doctor;
        firstDay = ClinicTime.Today;
        failure = null;
        confirmation = null;
        await LoadFreeSlotsAsync();
    }

    private async Task ShowEarlierAsync()
    {
        firstDay = firstDay.AddDays(-DaysShown);
        await LoadFreeSlotsAsync();
    }

    private async Task ShowLaterAsync()
    {
        firstDay = firstDay.AddDays(DaysShown);
        await LoadFreeSlotsAsync();
    }

    private void SelectDay(DateOnly day)
    {
        selectedDay = day;
        selectedSlot = null;
    }

    private void SelectSlot(AvailableSlot slot)
    {
        selectedSlot = slot;
        failure = null;
        confirmation = null;
    }

    private async Task LoadFreeSlotsAsync()
    {
        if (selectedDoctor is null)
        {
            return;
        }

        freeSlots = null;
        selectedSlot = null;

        var lastDay = firstDay.AddDays(DaysShown - 1);
        var offered = await Api.GetAvailabilityAsync(selectedDoctor.Id, firstDay, lastDay);

        var booked = new List<DateTimeOffset>();
        if (offered.Count > 0)
        {
            booked = await Api.GetBookedSlotsAsync(selectedDoctor.Id, offered[0].Start, offered[^1].End);
        }

        freeSlots = offered.Where(slot => !booked.Contains(slot.Start)).ToList();

        if (FreeSlotsOn(selectedDay).Count == 0)
        {
            selectedDay = ShownDays().FirstOrDefault(day => FreeSlotsOn(day).Count > 0, firstDay);
        }
    }

    private async Task ConfirmAsync()
    {
        if (selectedDoctor is null || selectedSlot is null)
        {
            return;
        }

        booking = true;
        failure = await Api.BookAsync(selectedDoctor.Id, selectedSlot.Start);
        if (failure is null)
        {
            confirmation = $"Booked with {selectedDoctor.FullName} on {ClinicTime.WeekdayAndTime(selectedSlot.Start)}.";
        }

        await LoadFreeSlotsAsync();
        booking = false;
    }
}
