@inject JwtAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<aside class="sidebar">
    <a class="sidebar__brand" href="">MediView</a>

    <AuthorizeView>
        <Authorized>
            @{
                var sections = Sections.Where(entry => context.User.IsInRole(entry.Role)).ToList();
                var avatarRole = sections.FirstOrDefault()?.AvatarRole ?? "patient";
            }
            <nav class="sidebar__nav" aria-label="Main">
                @foreach (var navSection in sections)
                {
                    <div class="sidebar__section">
                        <span class="sidebar__section-label">@navSection.Role</span>
                        @Links(navSection.Items)
                    </div>
                }
            </nav>

            <div class="sidebar__user">
                <span class="mv-avatar mv-avatar--@avatarRole" aria-hidden="true">@Initials.Of(context.User.DisplayName())</span>
                <div class="sidebar__user-text">
                    <span class="sidebar__user-name">@context.User.DisplayName()</span>
                    <button type="button" class="sidebar__sign-out" @onclick="SignOutAsync">Sign out</button>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <nav class="sidebar__nav" aria-label="Main">
                <div class="sidebar__section">
                    @Links(AnonymousItems)
                </div>
            </nav>
        </NotAuthorized>
    </AuthorizeView>
</aside>

@code {
    private static readonly NavSection[] Sections =
    [
        new(MediViewRoles.Patient, "patient", [new("book", "Book a checkup"), new("my-studies", "My studies")]),
        new(MediViewRoles.Doctor, "doctor", [new("worklist", "Worklist")]),
        new(MediViewRoles.Admin, "admin", [new(LandingPage.AdminDoctors, "Doctors"), new("admin/import", "Import x-rays")]),
    ];

    private static readonly NavItem[] AnonymousItems = [new("login", "Sign in"), new("register", "Register")];

    private RenderFragment Links(IEnumerable<NavItem> items) =>
        @<ul class="sidebar__items">
            @foreach (var item in items)
            {
                <li><NavLink href="@item.Href">@item.Label</NavLink></li>
            }
        </ul>;

    private async Task SignOutAsync()
    {
        await AuthState.SignOutAsync();
        Navigation.NavigateTo("login");
    }

    private sealed record NavSection(string Role, string AvatarRole, IReadOnlyList<NavItem> Items);

    private sealed record NavItem(string Href, string Label);
}
