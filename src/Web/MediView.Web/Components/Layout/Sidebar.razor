@inject JwtAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<aside class="sidebar">
    <a class="sidebar__brand" href="">MediView</a>

    <AuthorizeView>
        <Authorized>
            <nav class="sidebar__nav" aria-label="Main">
                @if (context.User.IsInRole(Roles.Patient))
                {
                    <div class="sidebar__section">
                        <span class="sidebar__section-label">Patient</span>
                        <ul class="sidebar__items">
                            <li><NavLink href="book">Book a checkup</NavLink></li>
                            <li><NavLink href="my-studies">My studies</NavLink></li>
                        </ul>
                    </div>
                }

                @if (context.User.IsInRole(Roles.Doctor))
                {
                    <div class="sidebar__section">
                        <span class="sidebar__section-label">Doctor</span>
                        <ul class="sidebar__items">
                            <li><NavLink href="worklist">Worklist</NavLink></li>
                        </ul>
                    </div>
                }

                @if (context.User.IsInRole(Roles.Admin))
                {
                    <div class="sidebar__section">
                        <span class="sidebar__section-label">Admin</span>
                        <ul class="sidebar__items">
                            <li><NavLink href="admin/doctors">Doctors</NavLink></li>
                            <li><NavLink href="admin/import">Import x-rays</NavLink></li>
                        </ul>
                    </div>
                }
            </nav>

            <div class="sidebar__user">
                <span class="mv-avatar mv-avatar--@AvatarStyle(context.User)" aria-hidden="true">@Initials.Of(context.User.GetName())</span>
                <div class="sidebar__user-text">
                    <span class="sidebar__user-name">@context.User.GetName()</span>
                    <button type="button" class="sidebar__sign-out" @onclick="SignOutAsync">Sign out</button>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <nav class="sidebar__nav" aria-label="Main">
                <div class="sidebar__section">
                    <ul class="sidebar__items">
                        <li><NavLink href="login">Sign in</NavLink></li>
                        <li><NavLink href="register">Register</NavLink></li>
                    </ul>
                </div>
            </nav>
        </NotAuthorized>
    </AuthorizeView>
</aside>

@code {
    private static string AvatarStyle(ClaimsPrincipal user)
    {
        if (user.IsInRole(Roles.Admin))
        {
            return "admin";
        }

        if (user.IsInRole(Roles.Doctor))
        {
            return "doctor";
        }

        return "patient";
    }

    private async Task SignOutAsync()
    {
        await AuthState.SignOutAsync();
        Navigation.NavigateTo("login");
    }
}
