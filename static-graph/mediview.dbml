// =====================================================================
// MediView - database design (v3)
// Paste into https://dbdiagram.io
//
// v3 aligns the schema with the 15 UI screens and standard healthcare
// practice. New since v2:
//   MRN + allergies · study numbers, priority, laterality, follow-up chain
//   persisted viewport lock (owner, TTL, release reason) + lock watchers
//   saved Cornerstone measurements · report addenda + critical findings
//   cart separate from bill · invoice/RX numbers · feature flags
//   PHI access log (who *read* a record, not only who changed it)
//
// FIXED FROM THE DRAFT
//   - FK columns are uuid (the draft still had
//     Doctor_Working_Hours.working_hours_id as varchar(255))
//   - status columns are enums, not free-text varchar(255)
//   - working hours are structured day/time columns
//   - license/phone are varchar; join tables unique; FKs indexed
//   - created_at / updated_at, not null, timestamptz
//
// BOUNDARY RULE: one schema per microservice. Refs inside a schema are
// real FKs. Refs marked "logical" cross a service boundary - drawn here
// for readability, but NOT created as database-level FKs.
// =====================================================================

Project MediView {
  database_type: 'PostgreSQL'
  Note: '''
Medical imaging + diagnosis platform.

The Study status (todo -> in_progress -> re_diagnosis -> done) is the single
source of truth for the whole workflow. Patients self-register and book inside
a doctor working hours; an admin simulates the x-ray import; a doctor reads the
study in a single-writer locked viewport, finalizes a report and issues a
prescription; the patient pays from an in-app wallet.

Auth, DICOM import and Payment each sit behind a feature flag: internal
implementation today, external provider later.
'''
}

// ---------------------------------------------------------------------
// Enums  (CHECK constraints in the generated SQL)
// ---------------------------------------------------------------------

Enum gender {
  male
  female
  other
  unspecified
}

Enum diagnosis_status {
  todo          [note: 'booked; images may be imported, not yet read']
  in_progress   [note: 'a doctor holds the lock and is reading']
  re_diagnosis  [note: 'another read requested']
  done          [note: 'finalized; no further read']
}

Enum study_priority {
  routine
  urgent
  stat
}

Enum laterality {
  left
  right
  bilateral
  not_applicable
}

Enum actor_role {
  doctor
  admin
  patient
  system
}

Enum credential_kind {
  certificate
  award
  degree
  license
  other
}

Enum appointment_status {
  booked
  cancelled
  completed
  no_show
}

Enum import_source {
  admin_upload [note: 'the x-ray simulation']
  modality
  pacs
}

Enum job_status {
  pending
  processing
  completed
  failed
}

Enum lock_release_reason {
  manual      [note: 'doctor finalized or closed']
  logout
  ttl_expired [note: 'idle auto-release']
  admin_force [note: 'break-glass; always audited']
}

Enum report_status {
  draft
  finalized
}
Enum report_decision {
  done
  re_diagnosis
}
Enum prescription_status {
  draft
  issued
}
Enum cart_status {
  open
  ordered
  abandoned
}

Enum bill_kind {
  diagnosis_fee      [note: 'billed on finalize']
  prescription_order [note: 'billed on checkout']
}

Enum bill_status {
  unpaid
  paid
  cancelled
  refunded
}

Enum payment_provider {
  internal_wallet  [note: 'default: flag = internal']
  external_gateway [note: 'flag = external']
}

Enum payment_status {
  pending
  succeeded
  failed
}
Enum wallet_txn_type {
  top_up
  payment
  refund
}
Enum notification_channel {
  email
  sms
  in_app
}
Enum notification_status {
  pending
  sent
  failed
}
Enum allergy_severity {
  mild
  moderate
  severe
}

// =====================================================================
// AUTH  - only Patients self-register
// =====================================================================

Table auth.users {
  id                 uuid         [pk, not null, default: `gen_random_uuid()`]
  username           varchar(50)  [not null, unique]
  email              varchar(255) [unique, note: 'Notification needs an address']
  phone              varchar(30)
  password_hash      varchar(255) [not null]
  fullname           varchar(255)
  avatar             text
  dob                date
  gender             gender
  description        text
  is_active          boolean      [not null, default: true]
  last_login_at      timestamptz
  failed_login_count int          [not null, default: 0]
  locked_until       timestamptz  [note: 'brute-force lockout']
  created_at         timestamptz  [not null, default: `now()`]
  updated_at         timestamptz  [not null, default: `now()`]

  Note: 'Admins are seeded. Doctors are created by an admin. Only Patients self-register.'
}

Table auth.refresh_tokens {
  id             uuid         [pk, not null, default: `gen_random_uuid()`]
  user_id        uuid         [not null]
  token_hash     varchar(255) [not null, unique, note: 'hashed, single-use']
  expires_at     timestamptz  [not null]
  revoked_at     timestamptz
  replaced_by_id uuid         [unique, note: 'rotation chain']
  created_by_ip  inet
  created_at     timestamptz  [not null, default: `now()`]

  indexes { user_id }
}
Ref: auth.refresh_tokens.user_id > auth.users.id [delete: cascade]
Ref: auth.refresh_tokens.replaced_by_id - auth.refresh_tokens.id

// =====================================================================
// IDENTITY - roles, permissions, admin-created staff
// =====================================================================

Table identity.roles {
  id          uuid        [pk, not null, default: `gen_random_uuid()`]
  name        varchar(50) [not null, unique, note: 'Admin | Doctor | Patient']
  description text
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
}

Table identity.permissions {
  id           uuid         [pk, not null, default: `gen_random_uuid()`]
  code         varchar(100) [not null, unique, note: 'study.diagnose, study.status.override, ...']
  description  text
  is_grantable boolean      [not null, default: true, note: 'false = enforced server-side, greyed in the admin matrix']
  created_at   timestamptz  [not null, default: `now()`]
}

Table identity.role_permissions {
  id            uuid        [pk, not null, default: `gen_random_uuid()`]
  role_id       uuid        [not null]
  permission_id uuid        [not null]
  created_at    timestamptz [not null, default: `now()`]

  indexes { (role_id, permission_id) [unique] }
  Note: 'Admin is deliberately NOT granted study.diagnose. Break-glass changes status, never authorship of a report.'
}
Ref: identity.role_permissions.role_id > identity.roles.id [delete: cascade]
Ref: identity.role_permissions.permission_id > identity.permissions.id [delete: cascade]

Table identity.user_roles {
  id         uuid        [pk, not null, default: `gen_random_uuid()`]
  user_id    uuid        [not null, note: 'logical -> auth.users.id']
  role_id    uuid        [not null]
  granted_by uuid        [note: 'logical -> auth.users.id (admin)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes { (user_id, role_id) [unique] }
}
Ref: identity.user_roles.role_id > identity.roles.id [delete: cascade]
Ref: identity.user_roles.user_id > auth.users.id // logical (cross-service)

Table identity.admins {
  id         uuid        [pk, not null, default: `gen_random_uuid()`]
  user_id    uuid        [not null, unique, note: 'logical -> auth.users.id']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Seeded in the database; never self-registered.'
}
Ref: identity.admins.user_id - auth.users.id // logical (cross-service)

Table identity.doctors {
  id                uuid         [pk, not null, default: `gen_random_uuid()`]
  user_id           uuid         [not null, unique, note: 'logical -> auth.users.id']
  license_number    varchar(50)  [not null, unique, note: 'was int: licences are alphanumeric']
  emergency_contact varchar(30)  [note: 'was int: phone numbers are not integers']
  department        varchar(255)
  specialty         varchar(255) [note: 'e.g. Radiology - Thoracic']
  is_verified       boolean      [not null, default: false]
  verified_by       uuid
  verified_at       timestamptz
  created_at        timestamptz  [not null, default: `now()`]
  updated_at        timestamptz  [not null, default: `now()`]

  Note: 'Created by an admin only, after credentials are verified. Cannot be granted from the roles screen.'
}
Ref: identity.doctors.user_id - auth.users.id // logical (cross-service)
Ref: identity.doctors.verified_by > identity.admins.id

Table identity.doctor_credentials {
  id           uuid            [pk, not null, default: `gen_random_uuid()`]
  doctor_id    uuid            [not null]
  kind         credential_kind [not null]
  title        varchar(255)    [not null]
  issuer       varchar(255)
  issued_at    date
  expires_at   date
  document_url text            [note: 'blob key']
  verified_by  uuid
  verified_at  timestamptz
  created_at   timestamptz     [not null, default: `now()`]

  indexes { doctor_id }
  Note: 'Proof of experience: certificates, awards, degrees.'
}
Ref: identity.doctor_credentials.doctor_id > identity.doctors.id [delete: cascade]
Ref: identity.doctor_credentials.verified_by > identity.admins.id

// =====================================================================
// PATIENT & STUDIES - the workflow's source of truth
// =====================================================================

Table patient.patients {
  id                     uuid         [pk, not null, default: `gen_random_uuid()`]
  user_id                uuid         [not null, unique, note: 'logical -> auth.users.id']
  mrn                    varchar(20)  [not null, unique, note: 'Medical Record Number shown in the UI, e.g. MRN-1042']
  patient_anonymous_name varchar(255) [not null, note: 'de-identified DICOM PatientName']
  blood_type             varchar(5)
  created_at             timestamptz  [not null, default: `now()`]
  updated_at             timestamptz  [not null, default: `now()`]
}
Ref: patient.patients.user_id - auth.users.id // logical (cross-service)

Table patient.patient_allergies {
  id         uuid             [pk, not null, default: `gen_random_uuid()`]
  patient_id uuid             [not null]
  substance  varchar(255)     [not null]
  reaction   varchar(255)
  severity   allergy_severity [not null, default: 'mild']
  noted_at   date
  created_at timestamptz      [not null, default: `now()`]

  indexes { patient_id }
  Note: 'Prescribing safety: warn before an allergen is added to a prescription.'
}
Ref: patient.patient_allergies.patient_id > patient.patients.id [delete: cascade]

Table patient.studies {
  id                  uuid             [pk, not null, default: `gen_random_uuid()`]
  patient_id          uuid             [not null]
  study_number        varchar(20)      [not null, unique, note: 'human-readable, e.g. Study 001']
  study_instance_uid  varchar(64)      [not null, unique, note: 'DICOM (0020,000D)']
  accession_number    varchar(64)      [note: 'DICOM (0008,0050)']
  modality            varchar(16)      [note: 'CR, DX, CT, MR - moved off Disease']
  body_part           varchar(64)      [note: 'e.g. Chest PA']
  laterality          laterality       [not null, default: 'not_applicable']
  priority            study_priority   [not null, default: 'routine']
  study_date          timestamptz      [not null]
  diagnosis_status    diagnosis_status [not null, default: 'todo']
  appointment_id      uuid             [note: 'logical -> booking.appointments.id']
  parent_study_id     uuid             [note: 'follow-up chain: the prior study this one follows']
  referring_doctor_id uuid             [note: 'logical -> identity.doctors.id']
  images_imported_at  timestamptz      [note: 'guard: a read cannot start before this is set']
  description         text
  created_at          timestamptz      [not null, default: `now()`]
  updated_at          timestamptz      [not null, default: `now()`]

  indexes {
    patient_id
    diagnosis_status
    parent_study_id
  }
  Note: 'One row = one Study. Import does NOT change status; a study stays To do until a doctor opens it under lock.'
}
Ref: patient.studies.patient_id > patient.patients.id
Ref: patient.studies.parent_study_id > patient.studies.id
Ref: patient.studies.referring_doctor_id > identity.doctors.id // logical (cross-service)

Table patient.study_status_history {
  id              uuid             [pk, not null, default: `gen_random_uuid()`]
  study_id        uuid             [not null]
  from_status     diagnosis_status
  to_status       diagnosis_status [not null]
  changed_by      uuid             [note: 'logical -> auth.users.id']
  changed_by_role actor_role       [not null]
  reason          text             [note: 'mandatory for admin break-glass']
  changed_at      timestamptz      [not null, default: `now()`]

  indexes { (study_id, changed_at) }
  Note: 'Who moved this study to re-diagnosis, and why.'
}
Ref: patient.study_status_history.study_id > patient.studies.id [delete: cascade]

Table patient.study_locks {
  id             uuid                [pk, not null, default: `gen_random_uuid()`]
  study_id       uuid                [not null, unique, note: 'one writer at a time']
  doctor_id      uuid                [not null, note: 'logical -> identity.doctors.id']
  acquired_at    timestamptz         [not null, default: `now()`]
  last_heartbeat timestamptz         [not null, default: `now()`]
  expires_at     timestamptz         [not null, note: 'idle TTL, e.g. 15 minutes']
  released_at    timestamptz
  released_by    uuid                [note: 'logical -> auth.users.id']
  release_reason lock_release_reason
  created_at     timestamptz         [not null, default: `now()`]

  indexes { doctor_id }
  Note: 'Redis holds the authoritative lock; this is the durable record the UI shows (owner, elapsed, auto-release) and the audit trail for admin force-release.'
}
Ref: patient.study_locks.study_id - patient.studies.id [delete: cascade]
Ref: patient.study_locks.doctor_id > identity.doctors.id // logical (cross-service)

Table patient.lock_watchers {
  id          uuid        [pk, not null, default: `gen_random_uuid()`]
  study_id    uuid        [not null]
  doctor_id   uuid        [not null, note: 'logical -> identity.doctors.id']
  notified_at timestamptz
  created_at  timestamptz [not null, default: `now()`]

  indexes { (study_id, doctor_id) [unique] }
  Note: 'Backs "Notify me when free" - pushed over SignalR when the lock releases.'
}
Ref: patient.lock_watchers.study_id > patient.studies.id [delete: cascade]

Table patient.doctor_studies {
  id          uuid        [pk, not null, default: `gen_random_uuid()`]
  doctor_id   uuid        [not null, note: 'logical -> identity.doctors.id']
  study_id    uuid        [not null]
  is_primary  boolean     [not null, default: true]
  assigned_at timestamptz [not null, default: `now()`]
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  indexes { (doctor_id, study_id) [unique] }
}
Ref: patient.doctor_studies.study_id > patient.studies.id [delete: cascade]
Ref: patient.doctor_studies.doctor_id > identity.doctors.id // logical (cross-service)

Table patient.diseases {
  id                  uuid         [pk, not null, default: `gen_random_uuid()`]
  code                varchar(50)  [not null, unique, note: 'ICD-10 / SNOMED, e.g. C34.9']
  name                varchar(255) [not null]
  reference_image_url text
  description         text
  created_at          timestamptz  [not null, default: `now()`]
  updated_at          timestamptz  [not null, default: `now()`]

  Note: 'Catalog only. Modality describes the scan, so it lives on Study.'
}

Table patient.study_diseases {
  id         uuid        [pk, not null, default: `gen_random_uuid()`]
  study_id   uuid        [not null]
  disease_id uuid        [not null]
  note       text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes { (study_id, disease_id) [unique] }
}
Ref: patient.study_diseases.study_id > patient.studies.id [delete: cascade]
Ref: patient.study_diseases.disease_id > patient.diseases.id

// =====================================================================
// BOOKING - patients book only inside a doctor's working hours
// =====================================================================

Table booking.working_hours {
  id           uuid        [pk, not null, default: `gen_random_uuid()`]
  day_of_week  smallint    [not null, note: '0 = Sunday .. 6 = Saturday']
  start_time   time        [not null]
  end_time     time        [not null]
  slot_minutes int         [not null, default: 30]
  description  text
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  Note: 'Structured columns replace the free-text time_range, which could not be queried for availability.'
}

Table booking.doctor_working_hours {
  id               uuid        [pk, not null, default: `gen_random_uuid()`]
  doctor_id        uuid        [not null, note: 'logical -> identity.doctors.id']
  working_hours_id uuid        [not null, note: 'was varchar(255) in the draft']
  effective_from   date
  effective_to     date
  created_at       timestamptz [not null, default: `now()`]
  updated_at       timestamptz [not null, default: `now()`]

  indexes { (doctor_id, working_hours_id) [unique] }
}
Ref: booking.doctor_working_hours.working_hours_id > booking.working_hours.id [delete: cascade]
Ref: booking.doctor_working_hours.doctor_id > identity.doctors.id // logical (cross-service)

Table booking.appointments {
  id                    uuid               [pk, not null, default: `gen_random_uuid()`]
  patient_id            uuid               [not null, note: 'logical -> patient.patients.id']
  doctor_id             uuid               [not null, note: 'logical -> identity.doctors.id']
  study_id              uuid               [note: 'logical -> patient.studies.id']
  scheduled_start       timestamptz        [not null]
  scheduled_end         timestamptz        [not null]
  status                appointment_status [not null, default: 'booked']
  is_follow_up          boolean            [not null, default: false]
  parent_appointment_id uuid
  reason                text
  created_at            timestamptz        [not null, default: `now()`]
  updated_at            timestamptz        [not null, default: `now()`]

  indexes {
    (doctor_id, scheduled_start) [unique, note: 'no double-booking a slot']
    patient_id
  }
}
Ref: booking.appointments.parent_appointment_id > booking.appointments.id
Ref: booking.appointments.patient_id > patient.patients.id // logical (cross-service)
Ref: booking.appointments.doctor_id > identity.doctors.id   // logical (cross-service)

// =====================================================================
// IMAGING - DICOM Study > Series > Instance
// =====================================================================

Table imaging.series {
  id                  uuid        [pk, not null, default: `gen_random_uuid()`]
  study_id            uuid        [not null, note: 'logical -> patient.studies.id']
  series_instance_uid varchar(64) [not null, unique, note: 'DICOM (0020,000E)']
  series_number       int
  modality            varchar(16)
  body_part           varchar(64)
  instance_count      int         [not null, default: 0]
  description         text
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]

  indexes { study_id }
}
Ref: imaging.series.study_id > patient.studies.id // logical (cross-service)

Table imaging.instances {
  id                  uuid        [pk, not null, default: `gen_random_uuid()`]
  series_id           uuid        [not null]
  sop_instance_uid    varchar(64) [not null, unique, note: 'DICOM (0008,0018)']
  instance_number     int
  rows                int
  columns             int
  window_center       int         [note: 'default VOI for the viewport']
  window_width        int
  transfer_syntax_uid varchar(64)
  storage_path        text        [not null, note: 'blob key served over WADO-RS to Cornerstone']
  file_size_bytes     bigint
  created_at          timestamptz [not null, default: `now()`]

  indexes { series_id }
}
Ref: imaging.instances.series_id > imaging.series.id [delete: cascade]

Table imaging.annotations {
  id          uuid        [pk, not null, default: `gen_random_uuid()`]
  instance_id uuid        [not null]
  study_id    uuid        [not null, note: 'logical -> patient.studies.id']
  doctor_id   uuid        [not null, note: 'logical -> identity.doctors.id']
  tool_type   varchar(50) [not null, note: 'length | angle | rectangle_roi | ellipse_roi | arrow']
  tool_state  jsonb       [not null, note: 'Cornerstone tool state (handles, units, values)']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  indexes { (study_id, instance_id) }
  Note: 'Measurements persist so another doctor sees them read-only while the lock is held elsewhere.'
}
Ref: imaging.annotations.instance_id > imaging.instances.id [delete: cascade]

Table imaging.import_jobs {
  id             uuid          [pk, not null, default: `gen_random_uuid()`]
  study_id       uuid          [not null, note: 'logical -> patient.studies.id']
  source         import_source [not null, default: 'admin_upload']
  imported_by    uuid          [note: 'logical -> auth.users.id (admin)']
  status         job_status    [not null, default: 'pending']
  instance_count int           [not null, default: 0]
  total_bytes    bigint        [not null, default: 0]
  error_message  text
  started_at     timestamptz
  completed_at   timestamptz
  created_at     timestamptz   [not null, default: `now()`]

  indexes { study_id }
  Note: 'One row per "Import from X-ray" run; audited with admin, study and instance count.'
}
Ref: imaging.import_jobs.study_id > patient.studies.id // logical (cross-service)

// =====================================================================
// REPORTING - the read; its decision drives the Study status
// =====================================================================

Table reporting.reports {
  id              uuid            [pk, not null, default: `gen_random_uuid()`]
  study_id        uuid            [not null, note: 'logical -> patient.studies.id']
  doctor_id       uuid            [not null, note: 'logical -> identity.doctors.id']
  report_number   varchar(20)     [unique, note: 'human-readable, e.g. RP-0114']
  status          report_status   [not null, default: 'draft']
  findings        text
  impression      text            [note: 'radiology convention: findings then impression']
  decision        report_decision [note: 'done -> close; re_diagnosis -> another read']
  is_critical     boolean         [not null, default: false, note: 'critical results need acknowledgement']
  critical_ack_at timestamptz
  follow_up_weeks int             [note: 'drives the patient "book follow-up" prompt']
  pdf_url         text
  finalized_at    timestamptz
  created_at      timestamptz     [not null, default: `now()`]
  updated_at      timestamptz     [not null, default: `now()`]

  indexes { study_id }
  Note: 'A finalized report must carry a decision and a finalized_at. Finalizing exports the PDF, issues the prescription, sets the status and releases the lock.'
}
Ref: reporting.reports.study_id > patient.studies.id   // logical (cross-service)
Ref: reporting.reports.doctor_id > identity.doctors.id // logical (cross-service)

Table reporting.report_addenda {
  id         uuid        [pk, not null, default: `gen_random_uuid()`]
  report_id  uuid        [not null]
  doctor_id  uuid        [not null, note: 'logical -> identity.doctors.id']
  body       text        [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes { report_id }
  Note: 'A finalized report is never edited in place - corrections are appended as an addendum. Standard radiology practice and a defensible audit position.'
}
Ref: reporting.report_addenda.report_id > reporting.reports.id [delete: cascade]

// =====================================================================
// PRESCRIPTION - priced items feed the cart and the bill
// =====================================================================

Table prescription.drugs {
  id         uuid          [pk, not null, default: `gen_random_uuid()`]
  code       varchar(50)   [not null, unique]
  name       varchar(255)  [not null]
  form       varchar(50)   [note: 'tablet | capsule | syrup | injection']
  strength   varchar(50)   [note: 'e.g. 500 mg']
  unit       varchar(50)
  unit_price numeric(12,2) [not null, default: 0]
  is_active  boolean       [not null, default: true]
  created_at timestamptz   [not null, default: `now()`]
  updated_at timestamptz   [not null, default: `now()`]

  Note: 'The formulary shown in the prescription composer.'
}

Table prescription.prescriptions {
  id                  uuid                [pk, not null, default: `gen_random_uuid()`]
  study_id            uuid                [not null, note: 'logical -> patient.studies.id']
  report_id           uuid                [note: 'logical -> reporting.reports.id']
  prescribed_by       uuid                [not null, note: 'logical -> identity.doctors.id']
  prescription_number varchar(20)         [unique, note: 'human-readable, e.g. RX-0114']
  status              prescription_status [not null, default: 'draft']
  description         text
  pdf_url             text
  issued_at           timestamptz
  created_at          timestamptz         [not null, default: `now()`]
  updated_at          timestamptz         [not null, default: `now()`]

  indexes { study_id }
  Note: 'Issued to the patient when the report is finalized.'
}
Ref: prescription.prescriptions.study_id > patient.studies.id       // logical (cross-service)
Ref: prescription.prescriptions.prescribed_by > identity.doctors.id // logical (cross-service)
Ref: prescription.prescriptions.report_id > reporting.reports.id    // logical (cross-service)

Table prescription.prescription_items {
  id              uuid          [pk, not null, default: `gen_random_uuid()`]
  prescription_id uuid          [not null]
  drug_id         uuid          [not null]
  drug_name       varchar(255)  [not null, note: 'snapshot at issue time']
  unit_price      numeric(12,2) [not null, default: 0, note: 'snapshot at issue time']
  dosage          varchar(100)
  frequency       varchar(100)
  duration        varchar(100)
  quantity        int           [not null, note: 'fixed by the prescription; the cart cannot change it']
  created_at      timestamptz   [not null, default: `now()`]

  indexes { prescription_id }
}
Ref: prescription.prescription_items.prescription_id > prescription.prescriptions.id [delete: cascade]
Ref: prescription.prescription_items.drug_id > prescription.drugs.id

// =====================================================================
// BILLING - cart, bills, wallet (the default internal payment provider)
// =====================================================================

Table billing.carts {
  id              uuid        [pk, not null, default: `gen_random_uuid()`]
  patient_id      uuid        [not null, note: 'logical -> patient.patients.id']
  prescription_id uuid        [not null, note: 'logical -> prescription.prescriptions.id']
  status          cart_status [not null, default: 'open']
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  indexes { (patient_id, status) }
  Note: 'Only medications from an ISSUED prescription can enter the cart, and quantities are fixed by it.'
}

Table billing.cart_items {
  id                   uuid          [pk, not null, default: `gen_random_uuid()`]
  cart_id              uuid          [not null]
  prescription_item_id uuid          [not null, note: 'logical -> prescription.prescription_items.id']
  drug_name            varchar(255)  [not null]
  unit_price           numeric(12,2) [not null]
  quantity             int           [not null]
  line_total           numeric(14,2) [not null]
  created_at           timestamptz   [not null, default: `now()`]

  indexes { (cart_id, prescription_item_id) [unique] }
}
Ref: billing.cart_items.cart_id > billing.carts.id [delete: cascade]

Table billing.wallets {
  id         uuid          [pk, not null, default: `gen_random_uuid()`]
  patient_id uuid          [not null, unique, note: 'logical -> patient.patients.id']
  balance    numeric(14,2) [not null, default: 0, note: 'CHECK balance >= 0']
  currency   char(3)       [not null, default: 'USD']
  created_at timestamptz   [not null, default: `now()`]
  updated_at timestamptz   [not null, default: `now()`]
}
Ref: billing.wallets.patient_id - patient.patients.id // logical (cross-service)

Table billing.bills {
  id           uuid          [pk, not null, default: `gen_random_uuid()`]
  bill_number  varchar(20)   [not null, unique, note: 'human-readable, e.g. INV-0031']
  patient_id   uuid          [not null, note: 'logical -> patient.patients.id']
  study_id     uuid          [note: 'logical -> patient.studies.id']
  cart_id      uuid          [note: 'set for prescription orders']
  kind         bill_kind     [not null, default: 'diagnosis_fee']
  total_amount numeric(14,2) [not null, default: 0]
  status       bill_status   [not null, default: 'unpaid']
  paid_at      timestamptz
  created_at   timestamptz   [not null, default: `now()`]
  updated_at   timestamptz   [not null, default: `now()`]

  indexes { (patient_id, status) }
  Note: 'The diagnosis fee and the prescription order are separate bills, as the UI shows.'
}
Ref: billing.bills.cart_id > billing.carts.id
Ref: billing.bills.patient_id > patient.patients.id // logical (cross-service)

Table billing.bill_items {
  id          uuid          [pk, not null, default: `gen_random_uuid()`]
  bill_id     uuid          [not null]
  description varchar(255)  [not null]
  quantity    int           [not null, default: 1]
  unit_price  numeric(12,2) [not null]
  line_total  numeric(14,2) [not null]
  created_at  timestamptz   [not null, default: `now()`]

  indexes { bill_id }
}
Ref: billing.bill_items.bill_id > billing.bills.id [delete: cascade]

Table billing.payments {
  id                 uuid             [pk, not null, default: `gen_random_uuid()`]
  bill_id            uuid             [not null]
  provider           payment_provider [not null, default: 'internal_wallet']
  external_reference varchar(255)     [note: 'only when provider = external_gateway']
  idempotency_key    varchar(100)     [unique, note: 'stops double-charging on retry']
  amount             numeric(14,2)    [not null]
  status             payment_status   [not null, default: 'pending']
  failure_reason     text
  paid_at            timestamptz
  created_at         timestamptz      [not null, default: `now()`]

  indexes { bill_id }
  Note: 'The two-way flag: internal_wallet today, external_gateway later.'
}
Ref: billing.payments.bill_id > billing.bills.id

Table billing.wallet_transactions {
  id            uuid            [pk, not null, default: `gen_random_uuid()`]
  wallet_id     uuid            [not null]
  type          wallet_txn_type [not null]
  amount        numeric(14,2)   [not null]
  balance_after numeric(14,2)   [not null]
  payment_id    uuid
  description   varchar(255)
  created_at    timestamptz     [not null, default: `now()`]

  indexes { (wallet_id, created_at) }
  Note: 'Append-only ledger; balance_after makes every movement reconstructable.'
}
Ref: billing.wallet_transactions.wallet_id > billing.wallets.id [delete: cascade]
Ref: billing.wallet_transactions.payment_id > billing.payments.id

// =====================================================================
// NOTIFICATION
// =====================================================================

Table notification.notifications {
  id            uuid                 [pk, not null, default: `gen_random_uuid()`]
  user_id       uuid                 [not null, note: 'logical -> auth.users.id']
  channel       notification_channel [not null]
  subject       varchar(255)
  body          text
  related_type  varchar(50)          [note: 'study | bill | appointment | lock']
  related_id    uuid
  status        notification_status  [not null, default: 'pending']
  error_message text
  read_at       timestamptz          [note: 'for in_app']
  sent_at       timestamptz
  created_at    timestamptz          [not null, default: `now()`]

  indexes { (user_id, created_at) }
}
Ref: notification.notifications.user_id > auth.users.id // logical (cross-service)

// =====================================================================
// CONFIG - the feature flags surfaced on the admin screen
// =====================================================================

Table config.feature_flags {
  id          uuid         [pk, not null, default: `gen_random_uuid()`]
  key         varchar(100) [not null, unique, note: 'auth.provider.external | dicom.import.external | payment.provider.external']
  is_enabled  boolean      [not null, default: false, note: 'false = internal implementation']
  description text
  updated_by  uuid         [note: 'logical -> auth.users.id']
  updated_at  timestamptz  [not null, default: `now()`]

  Note: 'Every flag defaults to internal so the system runs with no external dependency.'
}

// =====================================================================
// AUDIT - mutations AND reads (PHI access must be traceable)
// =====================================================================

Table audit.audit_log {
  id             uuid         [pk, not null, default: `gen_random_uuid()`]
  actor_user_id  uuid         [note: 'logical -> auth.users.id']
  actor_role     actor_role
  action         varchar(100) [not null, note: 'e.g. study.status.override, lock.force_release']
  entity_type    varchar(50)  [not null]
  entity_id      uuid
  reason         text         [note: 'required for admin overrides']
  before_data    jsonb
  after_data     jsonb
  ip_address     inet
  correlation_id uuid         [note: 'ties the entry to a request/trace']
  created_at     timestamptz  [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, created_at)
    (actor_user_id, created_at)
  }
}
Ref: audit.audit_log.actor_user_id > auth.users.id // logical (cross-service)

Table audit.access_log {
  id            uuid        [pk, not null, default: `gen_random_uuid()`]
  actor_user_id uuid        [not null, note: 'logical -> auth.users.id']
  actor_role    actor_role
  patient_id    uuid        [note: 'logical -> patient.patients.id']
  study_id      uuid        [note: 'logical -> patient.studies.id']
  action        varchar(50) [not null, note: 'view_study | view_report | view_images | export_pdf']
  ip_address    inet
  created_at    timestamptz [not null, default: `now()`]

  indexes { (patient_id, created_at) }
  Note: 'Healthcare systems must answer "who LOOKED at this record", not only who changed it.'
}

// =====================================================================
// Table groups - one group per microservice
// =====================================================================

TableGroup Auth {
  auth.users
  auth.refresh_tokens
}

TableGroup Identity_Role_Permission {
  identity.roles
  identity.permissions
  identity.role_permissions
  identity.user_roles
  identity.admins
  identity.doctors
  identity.doctor_credentials
}

TableGroup Patient_Studies {
  patient.patients
  patient.patient_allergies
  patient.studies
  patient.study_status_history
  patient.study_locks
  patient.lock_watchers
  patient.doctor_studies
  patient.diseases
  patient.study_diseases
}

TableGroup Booking {
  booking.working_hours
  booking.doctor_working_hours
  booking.appointments
}

TableGroup Imaging {
  imaging.series
  imaging.instances
  imaging.annotations
  imaging.import_jobs
}

TableGroup Reporting {
  reporting.reports
  reporting.report_addenda
}

TableGroup Prescription {
  prescription.drugs
  prescription.prescriptions
  prescription.prescription_items
}

TableGroup Billing {
  billing.carts
  billing.cart_items
  billing.wallets
  billing.bills
  billing.bill_items
  billing.payments
  billing.wallet_transactions
}

TableGroup Notification {
  notification.notifications
}

TableGroup Config_Audit {
  config.feature_flags
  audit.audit_log
  audit.access_log
}
